# ---------------------------------------------------------------------------
# Plantilla de variables de entorno de Mesa 2.0 (sin valores reales).
#
# Copia este fichero a `.env.local` (ignorado por git) o define las variables
# en tu plataforma de despliegue. El perfil `local` (H2 de fichero) no
# necesita ninguna de estas variables.
# ---------------------------------------------------------------------------

# Perfil de Spring: `local` usa H2; en el hosting, un perfil como `produccion`.
SPRING_PROFILES_ACTIVE=

# Cadena de conexión de Neon: la *pooled* para la aplicación y la *directa*
# para las migraciones de Flyway (`neon env pull` las deja en .env.local).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Alternativa clásica de Spring; si está definida, manda sobre las de Neon.
SPRING_DATASOURCE_URL=
SPRING_DATASOURCE_USERNAME=
SPRING_DATASOURCE_PASSWORD=

# Sesión: secreto aleatorio de al menos 32 bytes y cookie solo por HTTPS.
MESA2_JWT_SECRET=
MESA2_COOKIE_SECURE=

# Fuerza bruta en el login (opcionales; por defecto 10 intentos / 15 minutos).
MESA2_LOGIN_INTENTOS=
MESA2_LOGIN_VENTANA_MINUTOS=

# Puerto del servidor (lo inyecta la plataforma; por defecto 8080).
PORT=
